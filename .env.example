# ====== BACKEND (server/) — hech qachon repoga qo'ymang, brauzerga chiqmaydi ======
PORT=8787
TELEGRAM_BOT_TOKEN=        # @BotFather bergan bot tokeni (FAQAT backend .env / hosting env'ida)
OWNER_CHAT_ID=             # sizning chat ID'ingiz (botga /start yozib, `npm run chat-id`)
PUBLIC_URL=http://localhost:8787   # `npm run new-site` chiqaradigan havola shu bilan boshlanadi (frontend manzili!)
ALLOWED_ORIGIN=            # frontend manzili (CORS), masalan https://sizning-sayt.netlify.app  (vergul bilan bir nechta)
# SITES_DIR=               # ixtiyoriy: mijoz saytlari JSON'lari papkasi (doimiy diskda)

# ====== FRONTEND (Vite, build vaqtida; ommaviy qiymat) ======
VITE_API_BASE=             # backend manzili, masalan https://love-api.onrender.com  (Netlify'da shart; bitta serverda bo'sh qoladi)
